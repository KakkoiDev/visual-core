{
  "$schema": "kakkoi-theme/1",
  "name": "Kakkoi",
  "version": "1.0.0",
  "notes": "Values for Basecoat 1.0.2 semantic tokens. Monochrome: hierarchy from type, space and rules. Colour only for error, success and warning. Every pair below is checked against WCAG 2.2 (ratios in 'contrast').",
  "light": {
    "--background": "#ffffff",
    "--foreground": "#000000",
    "--card": "#ffffff",
    "--card-foreground": "#000000",
    "--popover": "#ffffff",
    "--popover-foreground": "#000000",
    "--primary": "#000000",
    "--primary-foreground": "#ffffff",
    "--secondary": "#f2f2f2",
    "--secondary-foreground": "#000000",
    "--accent": "#f2f2f2",
    "--accent-foreground": "#000000",
    "--muted": "#f2f2f2",
    "--muted-foreground": "#595959",
    "--border": "#d4d4d4",
    "--input": "#767676",
    "--ring": "#000000",
    "--destructive": "#c4161c",
    "--destructive-foreground": "#ffffff",
    "--success": "#1e7a34",
    "--warning": "#8a5a00",
    "--info": "#000000",
    "--focus": "#000000",
    "--rule": "#000000",
    "--chart-1": "#000000",
    "--chart-2": "#595959",
    "--chart-3": "#949494",
    "--chart-4": "#c8c8c8",
    "--chart-grid": "#e5e5e5",
    "--radius": "0px"
  },
  "dark": {
    "--background": "#000000",
    "--foreground": "#ffffff",
    "--card": "#000000",
    "--card-foreground": "#ffffff",
    "--popover": "#0d0d0d",
    "--popover-foreground": "#ffffff",
    "--primary": "#ffffff",
    "--primary-foreground": "#000000",
    "--secondary": "#1a1a1a",
    "--secondary-foreground": "#ffffff",
    "--accent": "#1a1a1a",
    "--accent-foreground": "#ffffff",
    "--muted": "#1a1a1a",
    "--muted-foreground": "#a6a6a6",
    "--border": "#333333",
    "--input": "#8c8c8c",
    "--ring": "#ffffff",
    "--destructive": "#ff6b6b",
    "--destructive-foreground": "#000000",
    "--success": "#5cd67a",
    "--warning": "#f5b800",
    "--info": "#ffffff",
    "--focus": "#ffffff",
    "--rule": "#ffffff",
    "--chart-1": "#ffffff",
    "--chart-2": "#a6a6a6",
    "--chart-3": "#6b6b6b",
    "--chart-4": "#3d3d3d",
    "--chart-grid": "#262626",
    "--radius": "0px"
  },
  "contrast": {
    "light": {
      "foreground/background": "21:1",
      "muted-foreground/background": "7.0:1",
      "muted-foreground/muted": "6.3:1",
      "input/background (control edge)": "4.5:1",
      "destructive/background": "6.0:1",
      "success/background": "5.4:1",
      "warning/background": "5.9:1",
      "border/background": "1.5:1 — decorative rules only, never a control's only edge"
    },
    "dark": {
      "foreground/background": "21:1",
      "muted-foreground/background": "8.6:1",
      "input/background (control edge)": "6.3:1",
      "destructive/background": "7.6:1",
      "success/background": "11.3:1",
      "warning/background": "11.7:1"
    }
  },
  "font": {
    "display": "\"Bebas Neue\", \"Noto Sans JP\", Impact, sans-serif",
    "sans": "\"Inter\", \"Noto Sans JP\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "ja": "\"Noto Sans JP\", \"Inter\", \"Hiragino Sans\", \"Yu Gothic UI\", sans-serif",
    "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "system": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Hiragino Sans\", \"Noto Sans JP\", sans-serif"
  },
  "type": {
    "display":  { "family": "display", "size": 80, "lineHeight": 0.9,  "weight": 400, "tracking": "0.02em", "ja": { "family": "ja", "size": 56, "weight": 700, "tracking": "0" } },
    "heading-1": { "family": "display", "size": 40, "lineHeight": 1.0,  "weight": 400, "tracking": "0.02em", "ja": { "family": "ja", "size": 30, "weight": 700, "lineHeight": 1.3 } },
    "heading-2": { "family": "display", "size": 28, "lineHeight": 1.05, "weight": 400, "tracking": "0.03em", "ja": { "family": "ja", "size": 22, "weight": 700, "lineHeight": 1.35 } },
    "heading-3": { "family": "sans", "size": 18, "lineHeight": 1.4, "weight": 600 },
    "body":      { "family": "sans", "size": 16, "lineHeight": 1.6, "weight": 400, "ja": { "lineHeight": 1.8 } },
    "statement": { "family": "sans", "size": 16, "lineHeight": 1.6, "weight": 500 },
    "small":     { "family": "sans", "size": 14, "lineHeight": 1.5, "weight": 400 },
    "label":     { "family": "sans", "size": 13, "lineHeight": 1.4, "weight": 600 },
    "code":      { "family": "mono", "size": 14, "lineHeight": 1.55, "weight": 400 },
    "tabular":   { "family": "sans", "fontVariantNumeric": "tabular-nums", "note": "all times, counts, table numbers" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48, "16": 64, "24": 96 },
  "size": { "target": 44, "targetGap": 8, "column": 768, "railWidth": 280, "panelWidth": 400 },
  "rule": { "hairline": "1px solid var(--border)", "strong": "1px solid var(--rule)", "use": "Hairline between rows and sections; strong (foreground) under headers and around the generated-app frame." },
  "focus": { "outline": "2px solid var(--focus)", "offset": "2px", "onFilled": "2px outline + 2px offset ring sits outside the black fill, so it reads as a second edge, not a colour change" },
  "motion": {
    "fast": "120ms cubic-bezier(.2,0,0,1)",
    "panel": "200ms cubic-bezier(.2,0,0,1)",
    "cube": "48s linear infinite rotate3d",
    "reduced": "All transitions 0ms; the cube is drawn static; progress uses text + a static bar; streaming text appears without fades."
  }
}
