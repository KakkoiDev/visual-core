{
  "name": "tesserae",
  "private": true,
  "version": "0.3.1",
  "description": "Local-first terrain tileset authoring for Godot 4.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thmsglchr/tesserae.git"
  },
  "homepage": "https://github.com/Thmsglchr/tesserae#readme",
  "bugs": {
    "url": "https://github.com/Thmsglchr/tesserae/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:portability": "node scripts/check-portability.mjs",
    "cli": "tsx src/cli.ts",
    "check": "pnpm check:portability && pnpm build && pnpm test && pnpm cli smoke-default"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.0"
  }
}
